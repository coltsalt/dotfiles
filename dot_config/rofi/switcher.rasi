/* Rofi Komorebi Theme - Blueish-Grey & White Text */

* {
    /* The exact blueish-grey background from your screenshots */
    bg-color:            #1e222a; 
    
    /* The subtle, blueish overlay box highlight for the selected item */
    selected-bg:         #2e3440; 
    
    /* Clean, bright white for readability */
    fg-white:            #ffffff; 
    
    /* A softer grey-blue for unfocused text/placeholders */
    fg-dim:              #61afef;

    background-color:    transparent;
    text-color:          @fg-white;
    font:                "JetBrainsMono Nerd Font 11";
}

window {
    background-color:    @bg-color;
    border:              1px;
    border-color:        #2d3139;
    border-radius:       16px;    /* Matches the clean rounded corners */
    width:               420px;   /* Fits beautifully as a compact menu */
    padding:             20px;
}

mainbox {
    children:            [ inputbar, listview ];
    spacing:             12px;
}

inputbar {
    background-color:    transparent;
    border:              1px;
    border-color:        #3b4252;
    border-radius:       10px;
    padding:             8px 12px;
    children:            [ prompt, entry ];
}

prompt {
    text-color:          @fg-dim;
    margin:              0px 6px 0px 0px;
}

entry {
    text-color:          @fg-white;
    placeholder:         "Search...";
    placeholder-color:   #4c566a;
}

listview {
    fixed-height:        false;
    dynamic:             true;
    scrollbar:           false;
    spacing:             4px;
    lines:               8;
}

element {
    padding:             8px 12px;
    border-radius:       8px;
    background-color:    transparent;
    text-color:          @fg-white;
}

/* The blueish overlay selection style from your reference images */
element selected {
    background-color:    @selected-bg;
    text-color:          @fg-white;
}

element-text {
    background-color:    transparent;
    text-color:          inherit;
    vertical-align:      0.5;
}

element-icon {
    size:                18px;
    margin:              0px 10px 0px 0px;
    text-color:          inherit;
}